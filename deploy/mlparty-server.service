# systemd unit for a bare-metal (non-Docker) ml-party server.
# Install:  cp deploy/mlparty-server.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now mlparty-server
# Boot-time start without login: sudo loginctl enable-linger <user>
# Adjust paths; keep --host 127.0.0.1 unless TLS terminates in front.

[Unit]
Description=ml-party tracking server (UI + read API + sync ingest)
After=network.target

[Service]
# token comes from ML_PARTY_TOKEN; put it in a root-readable drop-in or
# EnvironmentFile rather than editing this unit in place
ExecStart=/path/to/ml-party/.venv/bin/mlp serve --root /path/to/store --port 7327
EnvironmentFile=%h/.config/mlparty/server.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
